		sourceColumn: weekday
		sortByColumn: iso_dow

	column is_payday_window
		dataType: boolean
		lineageTag: b9c5b45b-dbc0-565f-be96-3086e67a79c3
		summarizeBy: none
		sourceColumn: is_payday_window

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_short", type text}, {"year_month", type text}, {"month_start", type date}, {"iso_dow", Int64.Type}, {"weekday", type text}, {"is_payday_window", type logical}}, "en-US")
				in
				    Typed

