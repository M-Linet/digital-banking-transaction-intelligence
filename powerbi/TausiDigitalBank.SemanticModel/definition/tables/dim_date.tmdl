table dim_date
	lineageTag: bff07fc3-ba63-5b3c-99e0-b1a35d32ae66
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 00d708da-c8e8-5756-a5d2-2f9610248fc8
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		lineageTag: 60373484-48fe-50e3-b09c-8e74bc77b77b
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: af9f5923-3baf-5a0f-8826-e931d1c0d314
		summarizeBy: none
		sourceColumn: month_number

	column month_short
		dataType: string
		lineageTag: af7adb77-30b0-5909-a92e-a44946bb22a7
		summarizeBy: none
