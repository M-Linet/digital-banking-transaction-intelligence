	partition fact_customer_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_customer_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"customer_id", type text}, {"segment", type text}, {"month", type date}, {"is_active", type logical}, {"is_new_customer", type logical}, {"successful", Int64.Type}, {"value_kes", Currency.Type}, {"fee_income", Currency.Type}, {"operational_failures", Int64.Type}}, "en-US")
				in
				    Typed

